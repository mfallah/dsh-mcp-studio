{
  "name": "@mfallah/dsh-mcp-studio",
  "version": "0.1.0",
  "description": "Visual MCP Studio for DeepSeek Harness: browse a catalog, install, connect, test and manage MCP servers from inside the harness UI — no YAML editing.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "mcp-client"
  ],
  "license": "MIT",
  "author": "mfallah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfallah/dsh-mcp-studio.git"
  },
  "homepage": "https://github.com/mfallah/dsh-mcp-studio#readme",
  "bugs": {
    "url": "https://github.com/mfallah/dsh-mcp-studio/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=22"
  },
  "files": [
    "lib",
    "patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.12",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^4.4.3"
  }
}
